SUPABASE_PROJECT_REF=vwtwbgnbmysjcjvolvbi
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
# Usa SUPABASE_DB_URL si prefieres copiar el JDBC completo desde el dashboard.
# Ejemplo pooler IPv4: jdbc:postgresql://aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_URL=
